# Local SQLite is the default. Set DATABASE_URL to a PostgreSQL URL when available.
DATABASE_URL=sqlite:///./continuityos.db

# Replace this placeholder with a random value of at least 32 characters.
# Use the same secret across all production workers; never commit a real secret.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters

# Keep false for local HTTP. Set true when serving over HTTPS in production.
SESSION_COOKIE_SECURE=false

# Optional. When set, newly reconstructed source lines are sent to OpenRouter
# for candidate extraction. Keep the key private and never commit the real key.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
